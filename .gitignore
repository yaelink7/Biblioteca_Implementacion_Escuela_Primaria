# --- Secretos: NUNCA subir las llaves de Supabase ---
.env
.env.local
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Pruebas y cobertura ---
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# --- Editor ---
# Se versiona la configuracion compartida del equipo, no las preferencias
# personales que VS Code guarda en esta misma carpeta.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/

# --- Sistema operativo ---
Thumbs.db
desktop.ini
.DS_Store

# --- Respaldos generados por el sistema ---
respaldos/*.csv

